#!/usr/bin/env bash
set -euo pipefail

REPO_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

detect_target() {
  local ip
  ip=$(ip -4 -o addr show tailscale0 2>/dev/null | awk '{print $4}' | cut -d/ -f1)
  case "$ip" in
    100.64.0.2) echo "nixos-server" ;;
    100.64.0.4) echo "nixos-desktop" ;;
    *) echo "" ;;
  esac
}

target="${1:-}"

if [ -z "$target" ]; then
  target="$(detect_target)"
fi

if [ -z "$target" ]; then
  echo "failed to detect tailscale IP." >&2
  read -rp "enter valid nix target name (nixos-server / nixos-desktop): " target
fi

if [ -z "$target" ]; then
  echo "abort." >&2
  exit 1
fi

echo "building nixos: nixos-rebuild switch --flake ${REPO_DIR}#${target}"
exec sudo nixos-rebuild switch --flake "${REPO_DIR}#${target}"
