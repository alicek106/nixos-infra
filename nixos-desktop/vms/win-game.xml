<!--
  win-game: Windows 11 VM for gaming, with the GTX 1660 SUPER passed through.
  See nixos-desktop/VM_PLAN.md. The GPU is held by vfio-pci on the host (modules/services/vfio.nix).
  Names wrapped in "@" are placeholders. nix replaces them with real /nix/store paths at
  build time (nixos-desktop/modules/services/vms.nix).
-->
<domain type='kvm'>
  <name>win-game</name>
  <!-- Fixed UUID, for the same reason as win-bank: redefining must keep the same VM,
       and the emulated TPM state lives under /var/lib/libvirt/swtpm/<uuid>/. -->
  <uuid>4b8e2f0c-9a1d-4c6e-8f3b-2d7a5e9c1b60</uuid>
  <!-- 12GiB of the host's 15GiB. All of it is pinned in host RAM (GPU passthrough), so the
       host keeps only ~3GiB: win-bank (4GiB) can't run at the same time, and heavy host work
       like nix builds should wait until this VM is off. -->
  <memory unit='GiB'>12</memory>
  <vcpu placement='static'>6</vcpu>

  <!-- Pin the 6 vCPUs to host cores 1-3 (host CPUs 2-7, two threads per core).
       The game then never shares a core with the host, which reduces stutter.
       Core 0 (host CPUs 0-1) is left for the host. That is enough while gaming, because
       nothing else heavy runs on the host then. win-bank can't run at the same time anyway
       (see memory above).
       emulatorpin: QEMU's own threads (disk and network I/O) also run on core 0, so they
       don't steal time from the vCPUs. -->
  <cputune>
    <vcpupin vcpu='0' cpuset='2'/>
    <vcpupin vcpu='1' cpuset='3'/>
    <vcpupin vcpu='2' cpuset='4'/>
    <vcpupin vcpu='3' cpuset='5'/>
    <vcpupin vcpu='4' cpuset='6'/>
    <vcpupin vcpu='5' cpuset='7'/>
    <emulatorpin cpuset='0-1'/>
  </cputune>

  <!-- UEFI with Secure Boot and the Microsoft keys already enrolled (OVMFFull).
       Some games' anti-cheat checks that Secure Boot is actually on, so it is enforced here.
       (win-bank uses QEMU's bundled firmware, which has no keys enrolled.)
       The firmware paths are set by hand, because libvirt's automatic firmware selection only
       sees QEMU's bundled firmware.
       On first start libvirt copies the VARS template to /var/lib/libvirt/qemu/nvram/.
       Later template changes do not touch that copy. -->
  <os>
    <type arch='x86_64' machine='q35'>hvm</type>
    <loader readonly='yes' secure='yes' type='pflash' format='raw'>@ovmfCode@</loader>
    <nvram template='@ovmfVarsMs@' templateFormat='raw'/>
  </os>

  <features>
    <acpi/>
    <apic/>
    <!-- Secure Boot firmware requires SMM (System Management Mode). -->
    <smm state='on'/>
    <!-- Hyper-V enlightenments: same as win-bank. -->
    <hyperv mode='custom'>
      <relaxed state='on'/>
      <vapic state='on'/>
      <spinlocks state='on' retries='8191'/>
      <vpindex state='on'/>
      <synic state='on'/>
      <stimer state='on'/>
      <frequencies state='on'/>
    </hyperv>
  </features>

  <!-- Expose the real host CPU. 3 cores x 2 threads matches the pinned host CPUs above,
       so Windows schedules threads the same way the hardware works. -->
  <cpu mode='host-passthrough' check='none' migratable='off'>
    <topology sockets='1' dies='1' cores='3' threads='2'/>
  </cpu>

  <!-- Windows keeps the hardware clock in local time, not UTC. -->
  <clock offset='localtime'>
    <timer name='rtc' tickpolicy='catchup'/>
    <timer name='pit' tickpolicy='delay'/>
    <timer name='hpet' present='no'/>
    <timer name='hypervclock' present='yes'/>
  </clock>

  <on_poweroff>destroy</on_poweroff>
  <on_reboot>restart</on_reboot>
  <on_crash>destroy</on_crash>
  <pm>
    <suspend-to-mem enabled='no'/>
    <suspend-to-disk enabled='no'/>
  </pm>

  <devices>
    <!-- System disk: sparse raw image on the nodatacow vm-images subvolume. Same as win-bank. -->
    <disk type='file' device='disk'>
      <driver name='qemu' type='raw' cache='none' io='native' discard='unmap'/>
      <source file='/var/lib/libvirt/images/win-game.raw'/>
      <target dev='vda' bus='virtio'/>
      <boot order='1'/>
    </disk>

    <!-- INSTALL ONLY: Windows installer ISO. The disk is empty at first, so the VM boots
         from here. Remove after installation (G4): a missing ISO file stops the VM from starting. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='/var/lib/libvirt/iso/win11.iso'/>
      <target dev='sda' bus='sata'/>
      <readonly/>
      <boot order='2'/>
    </disk>

    <!-- virtio drivers for Windows. Kept attached: it lives in the nix store. -->
    <disk type='file' device='cdrom'>
      <driver name='qemu' type='raw'/>
      <source file='@virtioWinIso@'/>
      <target dev='sdb' bus='sata'/>
      <readonly/>
    </disk>

    <!-- Plugged into br-vm. The MAC is reserved in dnsmasq -> 10.100.0.10.
         isolated='yes': can't talk to other VMs, only to the host. -->
    <interface type='bridge'>
      <source bridge='br-vm'/>
      <mac address='52:54:00:64:00:0a'/>
      <model type='virtio'/>
      <port isolated='yes'/>
    </interface>

    <!-- The GTX 1660 SUPER: all four functions of IOMMU group 6.
         GPU, HDMI audio, USB-C controller, USB-C UCSI.
         managed='yes': libvirt makes sure each one is on vfio-pci when the VM starts. -->
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source><address domain='0x0000' bus='0x01' slot='0x00' function='0x0'/></source>
    </hostdev>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source><address domain='0x0000' bus='0x01' slot='0x00' function='0x1'/></source>
    </hostdev>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source><address domain='0x0000' bus='0x01' slot='0x00' function='0x2'/></source>
    </hostdev>
    <hostdev mode='subsystem' type='pci' managed='yes'>
      <source><address domain='0x0000' bus='0x01' slot='0x00' function='0x3'/></source>
    </hostdev>

    <!-- Emulated TPM 2.0 via swtpm (Windows 11 requirement). -->
    <tpm model='tpm-crb'>
      <backend type='emulator' version='2.0'/>
    </tpm>

    <!-- INSTALL ONLY: SPICE screen with an emulated GPU, on the host's localhost.
         Used until the NVIDIA driver and the streaming server (Apollo) work. Remove in G4. -->
    <graphics type='spice' autoport='yes'>
      <listen type='address' address='127.0.0.1'/>
    </graphics>
    <video>
      <model type='virtio' heads='1' primary='yes'/>
    </video>
    <input type='tablet' bus='usb'/>

    <!-- SPICE agent and QEMU guest agent channels. -->
    <channel type='spicevmc'>
      <target type='virtio' name='com.redhat.spice.0'/>
    </channel>
    <channel type='unix'>
      <target type='virtio' name='org.qemu.guest_agent.0'/>
    </channel>

    <!-- No memory balloon. With a passed-through device all VM memory is pinned in host RAM
         (the GPU may access any of it by DMA), so the balloon could not give memory back anyway. -->
    <memballoon model='none'/>
  </devices>
</domain>
